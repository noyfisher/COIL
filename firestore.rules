rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile and sub-collections (assessments, rehabPlans, workoutSessions, notes)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Missing exercise images — any authenticated user can log missing images
    match /missingExerciseImages/{docId} {
      allow read, write: if request.auth != null;
    }

    // Session logs — authenticated users can write their own crash/session logs
    match /sessionLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
