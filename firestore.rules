rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile and sub-collections (assessments, rehabPlans, workoutSessions, notes)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Missing exercise images — any authenticated user can log missing images
    match /missingExerciseImages/{docId} {
      allow read, write: if request.auth != null;
    }

    // Session logs — authenticated users can write their own crash/session logs
    match /sessionLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Rate-limit counters (Tier 2 PR B). Only the Cloud Function Admin SDK
    // touches these — clients must NEVER be able to decrement or delete them
    // to sidestep the 20/min limit. Explicit deny for clarity; the default
    // would also be deny, but this prevents a future refactor from leaving
    // the path open.
    match /rateLimits/{uid}/windows/{windowKey} {
      allow read, write: if false;
    }
  }
}
