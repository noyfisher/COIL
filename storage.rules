rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Exercise images: any authenticated user can read
    match /exercise-images/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Session logs: only the owning user can read/write their own logs
    match /sessionLogs/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
